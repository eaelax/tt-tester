# Canonical production site URL (used for sitemaps and canonical/hreflang metadata)
APP_URL=https://tikprofilesviewer.com

# Required to enable /admintiktok login
ADMIN_PASSWORD=your_strong_admin_password

# Recommended HMAC secret for signing admin session cookies (defaults to derived key if omitted)
ADMIN_SESSION_SECRET=your_random_32_char_secret

# Optional: Persist /admintiktok global settings via Upstash Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Read/write global settings via Vercel Edge Config (when Upstash Redis is not configured)
EDGE_CONFIG=
VERCEL_API_TOKEN=